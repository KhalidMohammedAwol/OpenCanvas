{
  "name": "@filmboard/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@filmboard/contracts": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build --mode background && vite build --mode content && vite build --mode options",
